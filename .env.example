# Copy this file to .env.local before starting TournyHub.
# Replace these local-only placeholders when provider-backed features are added.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-high-entropy-secret-of-at-least-32-characters

# Optional for local email-only development. Set both to enable Google sign-in.
# Register this callback URL in Google Cloud:
# http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Optional. Without these, sign-in emails are written to the .dev-emails/
# directory instead of being sent, which is fine for local development.
# EMAIL_FROM="TournyHub <no-reply@example.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=replace-with-smtp-username
# SMTP_PASSWORD=replace-with-smtp-password

# Optional and test-only. Point the Playwright suite at an already-running dev
# server (its origin must equal NEXT_PUBLIC_APP_URL) instead of starting one on
# port 3100. Not read by the application itself.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
