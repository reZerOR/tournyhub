{
  "name": "tournyhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:db": "vitest run --config vitest.database.config.ts --configLoader runner",
    "test:browser": "playwright test",
    "env:check": "tsx scripts/validate-environment.ts",
    "db:start": "supabase db start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up --local",
    "db:reset": "supabase db reset --local",
    "db:status": "supabase migration list --local",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm env:check && pnpm test:unit && pnpm test:db && pnpm build && pnpm test:browser"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@next/env": "^16.3.5",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "csv-parse": "^7.0.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "postgres": "^3.4.9",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.33.0 <11"
  },
  "packageManager": "pnpm@10.33.0"
}
